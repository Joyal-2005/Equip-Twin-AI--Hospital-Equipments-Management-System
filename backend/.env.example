# Backend Server Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & Anomaly Detection
AI_MODEL_CONFIDENCE_THRESHOLD=0.75
AI_PROTOTYPE_MODE=true

# ServiceNow Integration (Disabled by default until valid credentials provided)
SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=https://dev00000.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_servicenow_password_here
SERVICENOW_TABLE_INCIDENT=incident
SERVICENOW_TABLE_TELEMETRY=u_hospital_equipment_telemetry
